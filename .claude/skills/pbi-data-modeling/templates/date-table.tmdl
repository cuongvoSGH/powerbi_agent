/// Fallback calendar (the liquidity dataset ships dim_date - use that when available). Covers history,
/// the projection horizon and the contractual tail. Fiscal year is named after the calendar year in which it ends.
table 'Dim Date'
	dataCategory: Time
	lineageTag: <guid>

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date Key]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column Quarter
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

	column Month
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

	column 'Year Month Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

	column 'Year Month'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Key'

	column 'Month End'
		dataType: dateTime
		formatString: Short Date
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month End]

	column 'Fiscal Year Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Year Number]

	column 'Fiscal Year'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Year]
		sortByColumn: 'Fiscal Year Number'

	column 'Fiscal Quarter'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Quarter]

	column 'Fiscal Month Number'
		dataType: int64
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Month Number]

	column 'Fiscal Period'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Period]
		sortByColumn: 'Fiscal Period Key'

	column 'Fiscal Period Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Period Key]

	column 'Is Month End'
		dataType: boolean
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Month End]

	column 'Days From Asof'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Days From Asof]

	column 'Period Type'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period Type]

	hierarchy 'Fiscal Calendar'
		lineageTag: <guid>

		level 'Fiscal Year'
			lineageTag: <guid>
			column: 'Fiscal Year'

		level 'Fiscal Quarter'
			lineageTag: <guid>
			column: 'Fiscal Quarter'

		level 'Fiscal Period'
			lineageTag: <guid>
			column: 'Fiscal Period'

		level Date
			lineageTag: <guid>
			column: Date

	partition 'Dim Date' = calculated
		mode: import
		source =
				VAR _FyStart = 1    // fiscal year start month: 1 = Jan, 4 = Apr, 7 = Jul, 10 = Oct
				VAR _AsOf = MAX ( 'Fact Bank Position'[Date] )                       // as-of = last snapshot month-end
				VAR _MinDate = MIN ( 'Fact Bank Position'[Date] )
				VAR _MaxDate = MAX ( MAX ( 'Fact Bank CF Contractual'[Date] ), _AsOf + 365 )   // contractual tail + projection horizon
				VAR _Start = DATE ( YEAR ( _MinDate ), 1, 1 )
				VAR _End = DATE ( YEAR ( _MaxDate ) + 1, 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( _Start, _End ),
				        "Date Key", YEAR ( [Date] ) * 10000 + MONTH ( [Date] ) * 100 + DAY ( [Date] ),
				        "Year", YEAR ( [Date] ),
				        "Quarter", "Q" & QUARTER ( [Date] ),
				        "Month Number", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "MMM" ),
				        "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				        "Month End", EOMONTH ( [Date], 0 ),
				        "Fiscal Year Number", YEAR ( [Date] ) + IF ( _FyStart > 1 && MONTH ( [Date] ) >= _FyStart, 1, 0 ),
				        "Fiscal Year", "FY" & ( YEAR ( [Date] ) + IF ( _FyStart > 1 && MONTH ( [Date] ) >= _FyStart, 1, 0 ) ),
				        "Fiscal Month Number", MOD ( MONTH ( [Date] ) - _FyStart, 12 ) + 1,
				        "Fiscal Quarter", "FQ" & ( INT ( MOD ( MONTH ( [Date] ) - _FyStart, 12 ) / 3 ) + 1 ),
				        "Fiscal Period", "P" & FORMAT ( MOD ( MONTH ( [Date] ) - _FyStart, 12 ) + 1, "00" ),
				        "Fiscal Period Key", MOD ( MONTH ( [Date] ) - _FyStart, 12 ) + 1,
				        "Is Month End", [Date] = EOMONTH ( [Date], 0 ),
				        "Days From Asof", INT ( [Date] - _AsOf ),
				        "Period Type", SWITCH ( TRUE (), [Date] < _AsOf, "History", [Date] = _AsOf, "As-of",
				                                [Date] <= _AsOf + 365, "Projection", "Contractual tail" )
				    )
